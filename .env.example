APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=change-this-to-a-long-random-string
APP_TIMEZONE=Asia/Baghdad

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=almaha_website
DB_USER=almaha_user
DB_PASS=replace-with-a-strong-password
DB_CHARSET=utf8mb4

SESSION_NAME=almaha_session
SESSION_LIFETIME=7200
SESSION_SECURE=true

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT=15
SMTP_USER=
SMTP_PASS=
SMTP_FROM=website@example.com
SMTP_FROM_NAME=Al-Maha Website
SMTP_TO=info@almaha-group.com

UPLOAD_MAX_MB=8
LOG_MAX_MB=10
LOG_MAX_FILES=5
LOG_VIEWER_MAX_ENTRIES=2000
